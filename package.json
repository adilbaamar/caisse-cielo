{
  "name": "cielo-app",
  "version": "1.2.0",
  "private": true,
  "description": "Cielo Montréal — application de commande (enveloppe native iOS/Android du site commande.cielomontreal.ca)",
  "scripts": {
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#7DA2BC' --iconBackgroundColorDark '#2f5068' --splashBackgroundColor '#eef6f9' --splashBackgroundColorDark '#172a36'",
    "ios": "npx cap add ios && npm run assets -- --ios",
    "android": "npx cap add android && npm run assets -- --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor/browser": "^8.0.5",
    "@capgo/capacitor-facebook-analytics": "^8.1.22",
    "capacitor-plugin-app-tracking-transparency": "^3.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "cielo-geofence": "file:plugins/cielo-geofence"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.2"
  }
}